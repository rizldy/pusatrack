<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Typography Styles -->
    <style name="TextAppearance.PusaTrack.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_ink</item>
    </style>

    <style name="TextAppearance.PusaTrack.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_ink</item>
    </style>

    <style name="TextAppearance.PusaTrack.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_ink</item>
    </style>

    <style name="TextAppearance.PusaTrack.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_ink</item>
    </style>

    <style name="TextAppearance.PusaTrack.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_ink</item>
    </style>

    <style name="TextAppearance.PusaTrack.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.PusaTrack.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PusaTrack.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.PusaTrack.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Borderless White Card v7 -->
    <style name="Widget.PusaTrack.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/shadow_card</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/shadow_card</item>
    </style>

    <style name="Widget.PusaTrack.Card.Large" parent="Widget.PusaTrack.Card">
        <item name="cardCornerRadius">@dimen/radius_card_lg</item>
    </style>

    <!-- Primary Pill Button (#17402F, white text, radius 28dp) -->
    <style name="Widget.PusaTrack.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primary_forest</item>
        <item name="android:textColor">@color/bg_white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.PusaTrack.LabelLarge</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="elevation">4dp</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/shadow_primary</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/shadow_primary</item>
    </style>

    <!-- Secondary Tonal Pill Button (#E3EEE6, #17402F text, radius 28dp) -->
    <style name="Widget.PusaTrack.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/primary_forest</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.PusaTrack.LabelLarge</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- White Pill Button (e.g. inside Hero Card) -->
    <style name="Widget.PusaTrack.Button.White" parent="Widget.Material3.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/bg_white</item>
        <item name="android:textColor">@color/primary_forest</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.PusaTrack.LabelLarge</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Circular White Back Button (44dp with soft shadow) -->
    <style name="Widget.PusaTrack.Button.Back" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/back_button_size</item>
        <item name="android:layout_height">@dimen/back_button_size</item>
        <item name="android:background">@drawable/bg_circle_white</item>
        <item name="android:elevation">6dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:src">@drawable/ic_arrow_back</item>
        <item name="android:tint">@color/text_ink</item>
        <item name="android:contentDescription">@string/cd_back</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/shadow_card</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/shadow_card</item>
    </style>

    <!-- Tonal Input EditText -->
    <style name="Widget.PusaTrack.EditText.Tonal" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_tonal</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textColor">@color/text_ink</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
    </style>

</resources>
