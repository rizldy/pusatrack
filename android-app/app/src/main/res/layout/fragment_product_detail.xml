<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:orientation="vertical"
    tools:context=".ui.products.ProductDetailFragment">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.PusaTrack.Button.Back"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PusaTrack.Headline"
                tools:text="Kopi Susu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Detail Resep · per 1 porsi"
                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Read-Only Lock Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_info_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/primary_forest" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="Hanya baca agar tidak terubah tanpa sengaja. Tekan Edit Resep untuk mengubah."
                    android:textColor="@color/primary_on_container"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Selling Price & Active Status Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PusaTrack.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Harga jual"
                            android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />

                        <TextView
                            android:id="@+id/tvSellingPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.PusaTrack.Display"
                            tools:text="Rp 10.000" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_safe"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/primary_forest"
                        android:textSize="12sp"
                        tools:text="Aktif" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- HPP & Margin Summary Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_preview_card"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:text="Perkiraan HPP"
                        android:textColor="@color/primary_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvEstimatedHpp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:textColor="@color/primary_on_container"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Rp 5.676" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:text="Estimasi Margin"
                        android:textColor="@color/primary_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMarginSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:textColor="@color/primary_on_container"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Rp 4.324 (43,2%)" />
                </LinearLayout>
            </LinearLayout>

            <!-- Recipe Composition -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Komposisi bahan (per 1 porsi)"
                android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium" />

            <LinearLayout
                android:id="@+id/containerRecipeRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptyRecipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_status_neutral"
                android:gravity="center"
                android:padding="18dp"
                android:text="Produk ini belum memiliki komposisi bahan (HPP Rp 0)."
                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white"
        android:elevation="10dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditRecipe"
            style="@style/Widget.PusaTrack.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Edit Resep" />
    </LinearLayout>
</LinearLayout>
