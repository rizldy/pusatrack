<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PusaTrack.Card.Large"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOrderNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium"
                    tools:text="PSN-014" />

                <TextView
                    android:id="@+id/tvSupplier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall"
                    tools:text="Pusat Pusa Coffee · oleh Afdal Rizaldy" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_low"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Berjalan"
                android:textColor="@color/secondary_text"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Vertical 3-Step Timeline + Right Tonal Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Step 1: Dipesan (Green check) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_circle_forest">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check_small" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStepOrdered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:textColor="@color/text_ink"
                        android:textSize="12sp"
                        tools:text="Dipesan · Sen, 16 Nov 2026 09:15" />
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="9dp"
                    android:background="@color/primary_container" />

                <!-- Step 2: Dalam perjalanan (Caramel dot) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_dot_caramel" />

                    <TextView
                        android:id="@+id/tvStepInTransit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"
                        tools:text="Dalam perjalanan · 2 hari (rata-rata 2 hr 4 jam)" />
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="9dp"
                    android:background="@color/outline_divider" />

                <!-- Step 3: Diterima (Muted circle) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_dot_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Diterima · Menunggu konfirmasi"
                        android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Tonal Status Icon Tile -->
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_menu_icon_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_orders"
                    android:tint="@color/primary_forest" />
            </FrameLayout>
        </LinearLayout>

        <!-- Items Summary -->
        <TextView
            android:id="@+id/tvItemsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_status_neutral"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_ink"
            android:textSize="12sp"
            tools:text="Bubuk Kopi (8 pak), Bubuk Strawberry (6 bungkus), Cup Plastik 12 oz (10 pak)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmReceive"
            style="@style/Widget.PusaTrack.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="Konfirmasi penerimaan" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
