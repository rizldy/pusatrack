<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Yellow Shield Icon (#FFF0B8) -->
        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_shield_yellow_circle">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield_check" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Periksa kembali pesanan"
            android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Cocokkan dengan permintaan pelanggan."
            android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />

        <!-- Items List -->
        <LinearLayout
            android:id="@+id/containerConfirmItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status_neutral"
            android:orientation="vertical"
            android:padding="14dp" />

        <!-- Summary Rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total"
                    android:textAppearance="@style/TextAppearance.PusaTrack.TitleSmall" />

                <TextView
                    android:id="@+id/tvConfirmTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/primary_forest"
                    android:textSize="16sp"
                    tools:text="Rp 30.000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Metode"
                    android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />

                <TextView
                    android:id="@+id/tvConfirmMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:textColor="@color/text_ink"
                    android:textSize="13sp"
                    tools:text="Tunai" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowConfirmReceived"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Uang diterima"
                    android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />

                <TextView
                    android:id="@+id/tvConfirmReceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:textColor="@color/text_ink"
                    android:textSize="13sp"
                    tools:text="Rp 50.000" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowConfirmChange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kembalian"
                    android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />

                <TextView
                    android:id="@+id/tvConfirmChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/primary_forest"
                    android:textSize="13sp"
                    tools:text="Rp 20.000" />
            </LinearLayout>
        </LinearLayout>

        <!-- Amber Lock Warning Banner (#FCF1DE) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_warning_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Setelah dikonfirmasi, transaksi tidak bisa dibatalkan atau diubah. Stok bahan berkurang otomatis sesuai resep."
                android:textColor="@color/secondary_text"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmSale"
            style="@style/Widget.PusaTrack.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="Ya, Konfirmasi Transaksi" />

        <TextView
            android:id="@+id/btnBackToCheck"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:gravity="center"
            android:text="Kembali dan periksa lagi"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
