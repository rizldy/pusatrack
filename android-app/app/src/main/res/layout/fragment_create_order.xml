<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:orientation="vertical"
    tools:context=".ui.orders.CreateOrderFragment">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.PusaTrack.Button.Back"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buat Pesanan"
                android:textAppearance="@style/TextAppearance.PusaTrack.Headline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Khusus bahan baku yang dipasok pusat"
                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Error Banner -->
            <LinearLayout
                android:id="@+id/layoutErrorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_error_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_error_outline" />

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:textColor="@color/tertiary_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Pemasok -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pemasok"
                android:textAppearance="@style/TextAppearance.PusaTrack.TitleSmall" />

            <EditText
                android:id="@+id/etSupplier"
                style="@style/Widget.PusaTrack.EditText.Tonal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Pusat Pusa Coffee"
                android:inputType="textCapWords"
                android:maxLines="1" />

            <!-- Tanggal & Jam Pesan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tanggal &amp; jam pesan"
                android:textAppearance="@style/TextAppearance.PusaTrack.TitleSmall" />

            <LinearLayout
                android:id="@+id/btnPickOrderDateTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_tonal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar" />

                <TextView
                    android:id="@+id/tvOrderDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:textColor="@color/text_ink"
                    android:textSize="14sp"
                    tools:text="Rab, 18 Nov 2026 · 09:45" />
            </LinearLayout>

            <!-- Bahan Dipesan Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daftar bahan dipesan"
                    android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddOrderItem"
                    style="@style/Widget.PusaTrack.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minHeight="40dp"
                    android:paddingHorizontal="14dp"
                    android:text="+ Tambah bahan"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerOrderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptyOrderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_neutral"
                android:gravity="center"
                android:padding="18dp"
                android:text="Belum ada bahan dipilih. Tekan Tambah bahan untuk memilih bahan dari pusat."
                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall"
                android:visibility="gone" />

            <!-- Total Pesanan Card (#E3EEE6) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_preview_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="Total pesanan"
                        android:textColor="@color/primary_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvOrderCounts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:textColor="@color/primary_on_container"
                        android:textSize="12sp"
                        tools:text="3 bahan · 26 kemasan" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOrderTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/primary_on_container"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Rp 1.960.000" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Bahan dengan cara pengadaan Beli langsung (mis. Susu UHT) dicatat lewat tombol Tambah stok di Detail Bahan."
                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white"
        android:elevation="10dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReviewOrder"
            style="@style/Widget.PusaTrack.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Periksa &amp; Simpan" />
    </LinearLayout>
</LinearLayout>
