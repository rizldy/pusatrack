<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    tools:context=".ui.orders.OrdersFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lacak Pesanan Stok"
                android:textAppearance="@style/TextAppearance.PusaTrack.Headline" />

            <FrameLayout
                android:id="@+id/btnNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="@string/cd_notifications"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_white"
                    android:elevation="6dp"
                    android:outlineAmbientShadowColor="@color/shadow_card"
                    android:outlineSpotShadowColor="@color/shadow_card"
                    tools:targetApi="p">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_notifications" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvNotificationBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/bg_badge_count"
                    android:elevation="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:textColor="@color/bg_white"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="2"
                    tools:visibility="visible" />
            </FrameLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="20dp"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hero Card: Rata-rata Lead Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_card"
                    android:baselineAligned="false"
                    android:elevation="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/shadow_primary"
                    android:outlineSpotShadowColor="@color/shadow_primary"
                    android:padding="20dp"
                    tools:targetApi="p">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                            android:text="Rata-rata lead time"
                            android:textColor="@color/primary_forest_soft_text"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvAvgLeadTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/bg_white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="2 hari 4 jam" />

                        <TextView
                            android:id="@+id/tvCompletedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:textColor="@color/primary_forest_soft_text"
                            android:textSize="11sp"
                            tools:text="dari 6 pesanan diterima" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="56dp"
                        android:layout_marginHorizontal="14dp"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Tercepat"
                            android:textColor="@color/primary_forest_soft_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvFastestLeadTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/bg_white"
                            android:textSize="14sp"
                            tools:text="1 hr 6 jam" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Terlama"
                            android:textColor="@color/primary_forest_soft_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSlowestLeadTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/bg_white"
                            android:textSize="14sp"
                            tools:text="3 hr 4 jam" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section: Sedang Dalam Perjalanan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Sedang dalam perjalanan"
                    android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium" />

                <LinearLayout
                    android:id="@+id/containerActiveOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/layoutEmptyActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_status_neutral"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada pesanan yang sedang berjalan"
                        android:textAppearance="@style/TextAppearance.PusaTrack.TitleSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Tekan Buat Pesanan untuk memesan bahan baku ke pusat."
                        android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />
                </LinearLayout>

                <!-- Section: Riwayat Terbaru -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Riwayat terbaru"
                    android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium" />

                <LinearLayout
                    android:id="@+id/containerReceivedOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Extended Pill Green FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCreateOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:text="Buat Pesanan"
        android:textAllCaps="false"
        android:textColor="@color/bg_white"
        app:backgroundTint="@color/primary_forest"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/bg_white" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
