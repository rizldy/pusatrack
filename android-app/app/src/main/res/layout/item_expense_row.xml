<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PusaTrack.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:text="Baris #1" />

            <ImageButton
                android:id="@+id/btnRemoveRow"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Hapus baris"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_tonal"
            android:paddingHorizontal="12dp" />

        <EditText
            android:id="@+id/etAmount"
            style="@style/Widget.PusaTrack.EditText.Tonal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:hint="Nominal (Rp), contoh: 25000"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etDescription"
            style="@style/Widget.PusaTrack.EditText.Tonal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:hint="Keterangan (opsional), contoh: 2 kantong"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
