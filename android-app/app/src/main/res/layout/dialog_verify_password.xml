<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_success_circle">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock"
            android:tint="@color/primary_forest" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Verifikasi password kamu"
        android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvVerifySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall"
        tools:text="Masukkan password akunmu (Natashya Rosario) untuk melanjutkan aksi sensitif ini." />

    <LinearLayout
        android:id="@+id/containerPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_tonal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/etCurrentPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:hint="Password akun aktif"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/text_ink"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnTogglePassword"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_toggle_password"
            android:src="@drawable/ic_visibility_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVerifyError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_error_banner"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/tertiary_text"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Password verifikasi salah. Coba lagi." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmVerify"
        style="@style/Widget.PusaTrack.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:text="Konfirmasi" />

    <TextView
        android:id="@+id/btnCancelVerify"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:gravity="center"
        android:text="Batal"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />
</LinearLayout>
