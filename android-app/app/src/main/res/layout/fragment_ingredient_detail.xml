<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:orientation="vertical"
    tools:context=".ui.inventory.IngredientDetailFragment">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.PusaTrack.Button.Back"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.PusaTrack.Headline"
                tools:text="Susu UHT Full Cream" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall"
                tools:text="1 kotak = 920 ml · Beli langsung" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Optional Ingredient Photo Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIngredientPhoto"
                style="@style/Widget.PusaTrack.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivIngredientPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto dokumentasi bahan"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Stock Summary Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PusaTrack.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:text="Stok saat ini"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvStatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_low"
                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/secondary_text"
                            android:textSize="12sp"
                            tools:text="Menipis" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStockUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.PusaTrack.Display"
                        tools:text="2.140 ml" />

                    <TextView
                        android:id="@+id/tvStockPackages"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        tools:text="Setara 2 kotak + 300 ml" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="14dp">

                        <ProgressBar
                            android:id="@+id/progressStock"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="7dp"
                            android:layout_gravity="center_vertical"
                            android:max="100"
                            android:progress="39"
                            android:progressBackgroundTint="@color/outline_divider"
                            android:progressTint="@color/secondary_caramel" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:background="@color/text_muted" />
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/outline_divider" />

                    <!-- Price & Minimum Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Harga bahan"
                                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />

                            <TextView
                                android:id="@+id/tvPackagePrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.PusaTrack.TitleSmall"
                                tools:text="Rp 18.500 / kotak" />

                            <TextView
                                android:id="@+id/tvUnitCost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall"
                                tools:text="Rp 20,11 per ml" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Batas minimum"
                                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />

                            <TextView
                                android:id="@+id/tvMinPackages"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.PusaTrack.TitleSmall"
                                tools:text="3 kotak" />

                            <TextView
                                android:id="@+id/tvMinUsage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall"
                                tools:text="= 2.760 ml" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_info_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info_outline" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="Stok berubah otomatis dari penjualan, pembelian, dan pemeriksaan fisik."
                    android:textColor="@color/primary_on_container"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Supplied-by-HQ Note (only visible for SUPPLIED ingredients) -->
            <LinearLayout
                android:id="@+id/bannerSuppliedNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_warning_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_orders"
                    android:tint="@color/secondary_text" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="Bahan dipasok dari pusat. Penambahan stok dilakukan melalui tab Pesanan saat barang diterima."
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Stock Movements History -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Riwayat pergerakan stok"
                android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMovements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_stock_movement" />

            <TextView
                android:id="@+id/tvEmptyMovements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:paddingVertical="20dp"
                android:text="Belum ada riwayat pergerakan stok."
                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar (Edit + optional Tambah Stok for DIRECT only) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditIngredient"
            style="@style/Widget.PusaTrack.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddStock"
            style="@style/Widget.PusaTrack.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1.35"
            android:text="Tambah stok" />
    </LinearLayout>
</LinearLayout>
