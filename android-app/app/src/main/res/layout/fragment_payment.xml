<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:orientation="vertical"
    tools:context=".ui.cashier.PaymentFragment">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.PusaTrack.Button.Back"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pembayaran"
                android:textAppearance="@style/TextAppearance.PusaTrack.Headline" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall"
                tools:text="Transaksi baru · Natashya Rosario" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ringkasan Pesanan Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PusaTrack.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ringkasan pesanan"
                        android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium" />

                    <LinearLayout
                        android:id="@+id/containerOrderLines"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/outline_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total"
                            android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium" />

                        <TextView
                            android:id="@+id/tvTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="@color/primary_forest"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Rp 30.000" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Metode Pembayaran Segmented Control -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Metode pembayaran"
                android:textAppearance="@style/TextAppearance.PusaTrack.TitleSmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_segmented_track"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnMethodCash"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="Tunai"
                    android:textColor="@color/bg_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnMethodQris"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:gravity="center"
                    android:text="QRIS"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Cash Input Section -->
            <LinearLayout
                android:id="@+id/layoutCashSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uang diterima (Rp)"
                    android:textAppearance="@style/TextAppearance.PusaTrack.TitleSmall" />

                <EditText
                    android:id="@+id/etAmountReceived"
                    style="@style/Widget.PusaTrack.EditText.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:hint="Masukkan nominal uang diterima"
                    android:inputType="number"
                    android:maxLines="1" />

                <!-- Quick Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipExactAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Uang pas"
                        android:textColor="@color/primary_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chip50k"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Rp 50.000"
                        android:textColor="@color/primary_forest"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chip100k"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Rp 100.000"
                        android:textColor="@color/primary_forest"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Cash Error Text -->
                <TextView
                    android:id="@+id/tvCashError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_error_banner"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="Uang diterima kurang dari total pembayaran."
                    android:textColor="@color/tertiary_text"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Kembalian Tonal Card (#E3EEE6) -->
                <LinearLayout
                    android:id="@+id/cardChange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_preview_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:text="Kembalian"
                        android:textColor="@color/primary_forest"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvChangeAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:textColor="@color/primary_on_container"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Rp 20.000" />
                </LinearLayout>
            </LinearLayout>

            <!-- QRIS Info Section -->
            <LinearLayout
                android:id="@+id/layoutQrisSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_info_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info_outline" />

                <TextView
                    android:id="@+id/tvQrisInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:text="Pembayaran QRIS dicatat manual sesuai nominal total transaksi. Pastikan pelanggan sudah menyelesaikan transfer sebelum konfirmasi."
                    android:textColor="@color/primary_on_container"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Harga menu tetap, tidak ada diskon."
                android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white"
        android:elevation="10dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReviewAndConfirm"
            style="@style/Widget.PusaTrack.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Periksa &amp; Konfirmasi" />
    </LinearLayout>
</LinearLayout>
