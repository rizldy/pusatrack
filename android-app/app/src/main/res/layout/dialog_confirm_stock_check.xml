<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Red Warning Icon (#FAE6E9 / #8B2F40) -->
        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_berry_circle">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error_outline" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Sesuaikan stok?"
            android:textAppearance="@style/TextAppearance.PusaTrack.TitleMedium"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvConfirmSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.PusaTrack.BodySmall"
            tools:text="1 bahan berubah, 3 bahan sesuai." />

        <!-- Discrepancy List -->
        <LinearLayout
            android:id="@+id/containerDiscrepancies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status_neutral"
            android:orientation="vertical"
            android:padding="14dp" />

        <!-- Reason & Optional Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Alasan penyesuaian"
            android:textAppearance="@style/TextAppearance.PusaTrack.TitleSmall" />

        <EditText
            android:id="@+id/etReason"
            style="@style/Widget.PusaTrack.EditText.Tonal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:hint="Selisih pemeriksaan fisik"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etDescription"
            style="@style/Widget.PusaTrack.EditText.Tonal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="Deskripsi (opsional)"
            android:inputType="textCapSentences"
            android:maxLines="2" />

        <!-- Amber Warning Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_warning_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Perubahan tercatat di riwayat stok dan tidak bisa dibatalkan."
                android:textColor="@color/secondary_text"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Red Destructive / Correction Pill Button (#A9475A) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmAdjust"
            style="@style/Widget.PusaTrack.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="Ya, Sesuaikan Stok"
            app:backgroundTint="@color/tertiary_berry" />

        <TextView
            android:id="@+id/btnBackCheck"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:gravity="center"
            android:text="Kembali"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
