<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- L01: Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.pusacoffee.pusatrack.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login" />

    <!-- 5 Root Bottom Navigation Tabs -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.pusacoffee.pusatrack.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <!-- L10: Inventori -->
    <fragment
        android:id="@+id/inventoryFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.InventoryFragment"
        android:label="@string/nav_inventory"
        tools:layout="@layout/fragment_inventory" />

    <fragment
        android:id="@+id/cashierFragment"
        android:name="com.pusacoffee.pusatrack.ui.cashier.CashierFragment"
        android:label="@string/nav_cashier"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/ordersFragment"
        android:name="com.pusacoffee.pusatrack.ui.orders.OrdersFragment"
        android:label="@string/nav_orders"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.pusacoffee.pusatrack.ui.history.HistoryFragment"
        android:label="@string/nav_history"
        tools:layout="@layout/fragment_placeholder" />

    <!-- M6a-M6c: Inventory Detail & Form Screens (L11-L14) -->
    <fragment
        android:id="@+id/ingredientDetailFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.IngredientDetailFragment"
        android:label="Detail Bahan"
        tools:layout="@layout/fragment_ingredient_detail">
        <argument
            android:name="ingredientId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/addStockFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.AddStockFragment"
        android:label="Tambah Stok"
        tools:layout="@layout/fragment_add_stock">
        <argument
            android:name="ingredientId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/addIngredientFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.AddIngredientFragment"
        android:label="Tambah Bahan"
        tools:layout="@layout/fragment_ingredient_form" />

    <fragment
        android:id="@+id/editIngredientFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.EditIngredientFragment"
        android:label="Edit Bahan"
        tools:layout="@layout/fragment_ingredient_form">
        <argument
            android:name="ingredientId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <!-- M11: Products & Recipes (L29-L32) -->
    <fragment
        android:id="@+id/productsFragment"
        android:name="com.pusacoffee.pusatrack.ui.products.ProductsFragment"
        android:label="@string/menu_products"
        tools:layout="@layout/fragment_products" />

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.pusacoffee.pusatrack.ui.products.ProductDetailFragment"
        android:label="Detail Resep"
        tools:layout="@layout/fragment_product_detail">
        <argument
            android:name="productId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/editRecipeFragment"
        android:name="com.pusacoffee.pusatrack.ui.products.EditRecipeFragment"
        android:label="Edit Resep"
        tools:layout="@layout/fragment_product_form">
        <argument
            android:name="productId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/addProductFragment"
        android:name="com.pusacoffee.pusatrack.ui.products.AddProductFragment"
        android:label="Tambah Produk"
        tools:layout="@layout/fragment_product_form" />

    <!-- Secondary Placeholder Destinations (MS-2 to MS-4) -->
    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.pusacoffee.pusatrack.ui.common.ModulePlaceholderFragment"
        android:label="@string/cd_notifications"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="title"
            android:defaultValue="Notifikasi"
            app:argType="string" />
        <argument
            android:name="moduleCode"
            android:defaultValue="L09 · Modul M5"
            app:argType="string" />
        <argument
            android:name="showBackButton"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/financeFragment"
        android:name="com.pusacoffee.pusatrack.ui.common.ModulePlaceholderFragment"
        android:label="@string/menu_finance"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="title"
            android:defaultValue="Rekap Keuangan"
            app:argType="string" />
        <argument
            android:name="moduleCode"
            android:defaultValue="L23 · Modul M9"
            app:argType="string" />
        <argument
            android:name="showBackButton"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.pusacoffee.pusatrack.ui.common.ModulePlaceholderFragment"
        android:label="@string/menu_reports"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="title"
            android:defaultValue="Laporan &amp; Ekspor"
            app:argType="string" />
        <argument
            android:name="moduleCode"
            android:defaultValue="L26 · Modul M10"
            app:argType="string" />
        <argument
            android:name="showBackButton"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.pusacoffee.pusatrack.ui.common.ModulePlaceholderFragment"
        android:label="@string/menu_expenses"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="title"
            android:defaultValue="Catat Pengeluaran"
            app:argType="string" />
        <argument
            android:name="moduleCode"
            android:defaultValue="L24 · Modul M8"
            app:argType="string" />
        <argument
            android:name="showBackButton"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/stockCheckFragment"
        android:name="com.pusacoffee.pusatrack.ui.common.ModulePlaceholderFragment"
        android:label="@string/menu_stock_check"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="title"
            android:defaultValue="Pemeriksaan Fisik"
            app:argType="string" />
        <argument
            android:name="moduleCode"
            android:defaultValue="L15 · Modul M6"
            app:argType="string" />
        <argument
            android:name="showBackButton"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/accountsFragment"
        android:name="com.pusacoffee.pusatrack.ui.common.ModulePlaceholderFragment"
        android:label="@string/menu_accounts"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="title"
            android:defaultValue="Manajemen Akun"
            app:argType="string" />
        <argument
            android:name="moduleCode"
            android:defaultValue="L33 · Modul M12"
            app:argType="string" />
        <argument
            android:name="showBackButton"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

</navigation>
