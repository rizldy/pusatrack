<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- L01: Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.pusacoffee.pusatrack.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login" />

    <!-- 5 Root Bottom Navigation Tabs -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.pusacoffee.pusatrack.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <!-- L10: Inventori -->
    <fragment
        android:id="@+id/inventoryFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.InventoryFragment"
        android:label="@string/nav_inventory"
        tools:layout="@layout/fragment_inventory" />

    <fragment
        android:id="@+id/cashierFragment"
        android:name="com.pusacoffee.pusatrack.ui.cashier.CashierFragment"
        android:label="@string/nav_cashier"
        tools:layout="@layout/fragment_cashier" />

    <fragment
        android:id="@+id/ordersFragment"
        android:name="com.pusacoffee.pusatrack.ui.orders.OrdersFragment"
        android:label="@string/nav_orders"
        tools:layout="@layout/fragment_orders" />

    <!-- M7: Purchase Orders & Lead Time (L18-L22) -->
    <fragment
        android:id="@+id/receiveOrderFragment"
        android:name="com.pusacoffee.pusatrack.ui.orders.ReceiveOrderFragment"
        android:label="Konfirmasi Penerimaan"
        tools:layout="@layout/fragment_receive_order">
        <argument
            android:name="orderId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/createOrderFragment"
        android:name="com.pusacoffee.pusatrack.ui.orders.CreateOrderFragment"
        android:label="Buat Pesanan"
        tools:layout="@layout/fragment_create_order" />

    <fragment
        android:id="@+id/orderCreatedFragment"
        android:name="com.pusacoffee.pusatrack.ui.orders.OrderCreatedFragment"
        android:label="Pesanan Dibuat"
        tools:layout="@layout/fragment_order_created">
        <argument
            android:name="orderId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/whatsAppOrderFragment"
        android:name="com.pusacoffee.pusatrack.ui.orders.WhatsAppOrderFragment"
        android:label="Pesan WhatsApp"
        tools:layout="@layout/fragment_whatsapp_order">
        <argument
            android:name="orderId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.pusacoffee.pusatrack.ui.history.HistoryFragment"
        android:label="@string/nav_history"
        tools:layout="@layout/fragment_history" />

    <!-- M3: Cashier Payment & Success (L04, L06) -->
    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.pusacoffee.pusatrack.ui.cashier.PaymentFragment"
        android:label="Pembayaran"
        tools:layout="@layout/fragment_payment" />

    <fragment
        android:id="@+id/transactionSuccessFragment"
        android:name="com.pusacoffee.pusatrack.ui.cashier.TransactionSuccessFragment"
        android:label="Transaksi Berhasil"
        tools:layout="@layout/fragment_transaction_success">
        <argument
            android:name="saleId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <!-- M4: Transaction Detail (L08) -->
    <fragment
        android:id="@+id/transactionDetailFragment"
        android:name="com.pusacoffee.pusatrack.ui.history.TransactionDetailFragment"
        android:label="Detail Transaksi"
        tools:layout="@layout/fragment_transaction_detail">
        <argument
            android:name="saleId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <!-- M6a-M6c: Inventory Detail & Form Screens (L11-L14) -->
    <fragment
        android:id="@+id/ingredientDetailFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.IngredientDetailFragment"
        android:label="Detail Bahan"
        tools:layout="@layout/fragment_ingredient_detail">
        <argument
            android:name="ingredientId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/addStockFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.AddStockFragment"
        android:label="Tambah Stok"
        tools:layout="@layout/fragment_add_stock">
        <argument
            android:name="ingredientId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/addIngredientFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.AddIngredientFragment"
        android:label="Tambah Bahan"
        tools:layout="@layout/fragment_ingredient_form" />

    <fragment
        android:id="@+id/editIngredientFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.EditIngredientFragment"
        android:label="Edit Bahan"
        tools:layout="@layout/fragment_ingredient_form">
        <argument
            android:name="ingredientId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <!-- M11: Products & Recipes (L29-L32) -->
    <fragment
        android:id="@+id/productsFragment"
        android:name="com.pusacoffee.pusatrack.ui.products.ProductsFragment"
        android:label="@string/menu_products"
        tools:layout="@layout/fragment_products" />

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.pusacoffee.pusatrack.ui.products.ProductDetailFragment"
        android:label="Detail Resep"
        tools:layout="@layout/fragment_product_detail">
        <argument
            android:name="productId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/editRecipeFragment"
        android:name="com.pusacoffee.pusatrack.ui.products.EditRecipeFragment"
        android:label="Edit Resep"
        tools:layout="@layout/fragment_product_form">
        <argument
            android:name="productId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/addProductFragment"
        android:name="com.pusacoffee.pusatrack.ui.products.AddProductFragment"
        android:label="Tambah Produk"
        tools:layout="@layout/fragment_product_form" />

    <!-- M5: Notifikasi Operasional (L09) -->
    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.pusacoffee.pusatrack.ui.notifications.NotificationsFragment"
        android:label="@string/cd_notifications"
        tools:layout="@layout/fragment_notifications" />

    <!-- M9: Rekap Keuangan (L23) -->
    <fragment
        android:id="@+id/financeFragment"
        android:name="com.pusacoffee.pusatrack.ui.finance.FinanceSummaryFragment"
        android:label="@string/menu_finance"
        tools:layout="@layout/fragment_finance_summary" />

    <!-- M10: Laporan & Ekspor .xlsx (L26) -->
    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.pusacoffee.pusatrack.ui.reports.ReportsFragment"
        android:label="@string/menu_reports"
        tools:layout="@layout/fragment_reports" />

    <!-- M8: Catat Pengeluaran (L24) -->
    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.pusacoffee.pusatrack.ui.expenses.RecordExpenseFragment"
        android:label="@string/menu_expenses"
        tools:layout="@layout/fragment_record_expense" />

    <!-- M6d: Pemeriksaan Fisik / Stok Opname (L15) -->
    <fragment
        android:id="@+id/stockCheckFragment"
        android:name="com.pusacoffee.pusatrack.ui.inventory.StockCheckFragment"
        android:label="@string/menu_stock_check"
        tools:layout="@layout/fragment_stock_check" />

    <!-- M12: Manajemen Akun (L33-L37) -->
    <fragment
        android:id="@+id/accountsFragment"
        android:name="com.pusacoffee.pusatrack.ui.accounts.AccountsFragment"
        android:label="@string/menu_accounts"
        tools:layout="@layout/fragment_accounts" />

    <fragment
        android:id="@+id/accountDetailFragment"
        android:name="com.pusacoffee.pusatrack.ui.accounts.AccountDetailFragment"
        android:label="Detail Akun"
        tools:layout="@layout/fragment_account_detail">
        <argument
            android:name="userId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/editAccountFragment"
        android:name="com.pusacoffee.pusatrack.ui.accounts.EditAccountFragment"
        android:label="Edit Akun"
        tools:layout="@layout/fragment_edit_account">
        <argument
            android:name="userId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/addAccountFragment"
        android:name="com.pusacoffee.pusatrack.ui.accounts.AddAccountFragment"
        android:label="Tambah Akun"
        tools:layout="@layout/fragment_add_account" />

    <fragment
        android:id="@+id/resetPasswordFragment"
        android:name="com.pusacoffee.pusatrack.ui.accounts.ResetPasswordFragment"
        android:label="Reset Password"
        tools:layout="@layout/fragment_reset_password">
        <argument
            android:name="userId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

</navigation>
